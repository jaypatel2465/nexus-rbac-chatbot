# ============================================================
# NeXus RBAC Chatbot — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
*.env

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store
**/.DS_Store

# Windows
Thumbs.db
desktop.ini

# ============================================================
# Project-specific
# ============================================================

# SQLite user/role database (generated at runtime)
roles_docs.db
*.db
*.sqlite3

# ChromaDB vector store (generated by seeder/indexer)
chroma_db/

# DuckDB structured query database (generated by seeder)
static/data/structured_queries.duckdb

# Runtime-uploaded documents
static/uploads/

# Keep the uploads directory structure
!static/uploads/.gitkeep

# Playwright test videos (generated at runtime)
videos/

# pytest HTML report (generated at runtime)
report.html

# API key file — NEVER commit this
app/rag_utils/secret_key.py

# Internal project report doc (not for public repo)
PROJECT_REPORT.md
